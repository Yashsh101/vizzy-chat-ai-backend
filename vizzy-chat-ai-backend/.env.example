APP_NAME=Vizzy Chat API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./vizzy_chat.db
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
LOG_LEVEL=INFO
HISTORY_WINDOW=3
AUTO_RESET_DB_ON_SCHEMA_MISMATCH=false
MOCK_STREAM_DELAY_MS=25
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
